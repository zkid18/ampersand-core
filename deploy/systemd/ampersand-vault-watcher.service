[Unit]
Description=Amperstand vault watcher (keeps FTS5 + by-id index in sync with direct file edits)
After=network-online.target amperstand-server.service
Wants=network-online.target
Requires=amperstand-server.service

[Service]
Type=simple
User=amperstand
Group=amperstand
WorkingDirectory=/var/lib/amperstand
EnvironmentFile=/etc/amperstand/env
ExecStart=/opt/amperstand/venv/bin/python3 /opt/amperstand/amperstand-core/scripts/vault_watcher.py /var/lib/amperstand/vault
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/amperstand

[Install]
WantedBy=multi-user.target
