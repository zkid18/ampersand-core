[Unit]
Description=Amperstand RSS feed sync (one-shot, fired by amperstand-feed-sync.timer)
After=network-online.target amperstand-server.service
Wants=network-online.target
Requires=amperstand-server.service

[Service]
Type=oneshot
User=amperstand
Group=amperstand
WorkingDirectory=/var/lib/amperstand
EnvironmentFile=/etc/amperstand/env
# `amperstand-admin feeds-sync` reads AMPERSTAND_API_KEY from the process env
# (loaded by EnvironmentFile= above) and POSTs to /feeds/sync in-process.
# Earlier versions of this unit used `sh -c 'curl ... -H "Authorization:
# Bearer $AMPERSTAND_API_KEY" ...'` which expanded the secret into curl's
# argv — visible to any local user via /proc/<pid>/cmdline. The new
# console-script never puts the key on a command line.
ExecStart=/opt/amperstand/venv/bin/amperstand-admin feeds-sync
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/amperstand
