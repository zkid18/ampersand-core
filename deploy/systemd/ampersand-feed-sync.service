[Unit]
Description=Ampersand RSS feed sync (one-shot, fired by ampersand-feed-sync.timer)
After=network-online.target ampersand-server.service
Wants=network-online.target
Requires=ampersand-server.service

[Service]
Type=oneshot
User=ampersand
Group=ampersand
WorkingDirectory=/var/lib/ampersand
EnvironmentFile=/etc/ampersand/env
ExecStart=/opt/ampersand/venv/bin/ampersand feed sync
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/ampersand
