[Unit]
Description=Amperstand IMAP email watcher (newsletters → vault)
After=network-online.target amperstand-server.service
Wants=network-online.target
Requires=amperstand-server.service

[Service]
Type=simple
User=amperstand
Group=amperstand
WorkingDirectory=/var/lib/amperstand
EnvironmentFile=/etc/amperstand/env
ExecStart=/opt/amperstand/venv/bin/amperstand email watch
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

# Hardening (matches amperstand-server.service profile)
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/amperstand

[Install]
WantedBy=multi-user.target
