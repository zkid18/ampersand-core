{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Amperstand",
  "description": "Self-hosted personal vault. Capture URLs, YouTube, RSS, and newsletters into a searchable store any client can query.",
  "colors": {
    "primary": "#0F172A",
    "light": "#3B82F6",
    "dark": "#0F172A"
  },
  "favicon": "/images/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Set up a server",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "concepts",
              "configuration",
              "deployment"
            ]
          }
        ]
      },
      {
        "tab": "Use the CLI",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli-install",
              "cli-reference"
            ]
          }
        ]
      },
      {
        "tab": "Embed in agents",
        "groups": [
          {
            "group": "Agents & skills",
            "pages": [
              "agent-shell",
              "agent-skill",
              "agent-prompt"
            ]
          }
        ]
      },
      {
        "tab": "Build clients",
        "groups": [
          {
            "group": "Build",
            "pages": [
              "build-client"
            ]
          },
          {
            "group": "API reference",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/capture",
              "api-reference/jobs",
              "api-reference/vault-docs",
              "api-reference/vault-search",
              "api-reference/feeds"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/zkid18/ampersand-core",
          "icon": "github"
        },
        {
          "anchor": "PyPI",
          "href": "https://pypi.org/project/amperstand/",
          "icon": "python"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo-dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/zkid18/ampersand-core"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zkid18"
    }
  }
}
